# Copy to .env (ignored by git) and fill in. A variable exported in the shell wins over this file.
# Required: a model your provider serves, and your API key.
SMOLAGENTS_MODEL_ID=claude-sonnet-5-5
SMOLAGENTS_API_KEY=
# Any OpenAI-compatible endpoint; this one (Anthropic's) is the default and the one tested.
SMOLAGENTS_API_BASE=https://api.anthropic.com/v1
# Optional
# SMOLAGENTS_TEMPERATURE=0.2
# SMOLAGENTS_MAX_STEPS=20
# SMOLAGENTS_PLANNING_INTERVAL=10
# SMOLAGENTS_RUNS_DIR=runs
