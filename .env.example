# Copy to .env (ignored by git) and fill in; variables set in the environment take precedence.
# Required: a model name your provider serves now, and your API key.
SMOLAGENTS_MODEL_ID=
SMOLAGENTS_API_KEY=
SMOLAGENTS_API_BASE=https://api.deepseek.com/v1
# Optional
# SMOLAGENTS_TEMPERATURE=0.2
# SMOLAGENTS_MAX_STEPS=20
# SMOLAGENTS_PLANNING_INTERVAL=10
# SMOLAGENTS_RUNS_DIR=runs
